<Window x:Class="RemoteGameStreamer.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniDeck" Icon="Assets/omnideck.ico"
        Width="1060" Height="700" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{StaticResource Page}" FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="60" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" BorderBrush="{StaticResource Rim}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Margin="18,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/omnideck.png" Width="34" Height="34" />
                    <TextBlock Text="OmniDeck" Foreground="{StaticResource Text}" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Border x:Name="StatusPill" CornerRadius="11" Padding="11,3" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Foreground="#071433" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource WindowButton}" Content="&#x2014;" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimize" ToolTip="Minimize" />
                    <Button Style="{StaticResource WindowButton}" Content="&#x25A1;" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximize" ToolTip="Maximize" />
                    <Button Style="{StaticResource WindowButton}" Content="&#x2715;" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="18,0,18,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Pairing -->
                <Border Style="{StaticResource CardBorder}">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Top" Text="Connect your phone" Foreground="{StaticResource Text}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Top" Text="Enter these in the OmniDeck app." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />

                        <TextBlock DockPanel.Dock="Top" Text="PC ADDRESS" Style="{StaticResource Caption}" Margin="0,24,0,4" />
                        <TextBlock DockPanel.Dock="Top" x:Name="AddressText" Text="&#x2014;" Foreground="{StaticResource Text}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Top" x:Name="OtherAddressesText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />

                        <TextBlock DockPanel.Dock="Top" Text="PIN" Style="{StaticResource Caption}" Margin="0,24,0,4" />
                        <TextBlock DockPanel.Dock="Top" x:Name="PinText" Text="------" Foreground="{StaticResource Accent}" FontSize="44" FontWeight="Bold" FontFamily="Consolas" />

                        <Border DockPanel.Dock="Top" x:Name="ProblemBox" Visibility="Collapsed" Background="#3A1530" BorderBrush="#FF6B8A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,20,0,0">
                            <TextBlock x:Name="ProblemText" Foreground="#FFD5DE" FontSize="13" TextWrapping="Wrap" />
                        </Border>

                        <Button DockPanel.Dock="Bottom" x:Name="ServerButton" Style="{StaticResource Action}" Click="OnServerToggle" Padding="14,11">
                            <TextBlock x:Name="ServerButtonText" Text="Stop server" FontWeight="SemiBold" />
                        </Button>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Live stream -->
                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="RESOLUTION" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="ResolutionText" Text="&#x2014;" Style="{StaticResource Value}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="FRAME RATE" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="FpsText" Text="&#x2014;" Style="{StaticResource Value}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="BITRATE" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="BitrateText" Text="&#x2014;" Style="{StaticResource Value}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="CODEC" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="CodecText" Text="&#x2014;" Style="{StaticResource Value}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="PHONE" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="PhoneText" Text="Not connected" Foreground="{StaticResource Text}" FontSize="14" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="CONTROLLER" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="ControllerText" Text="Off" Foreground="{StaticResource Text}" FontSize="14" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="ENCODER" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="EncoderText" Text="&#x2014;" Foreground="{StaticResource Text}" FontSize="14" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="3">
                                <TextBlock Text="CONNECTED FOR" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="UptimeText" Text="&#x2014;" Foreground="{StaticResource Text}" FontSize="14" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Logs -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Logs" Foreground="{StaticResource Text}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource Action}" Content="Copy" Click="OnCopyLogs" Padding="12,5" />
                                    <Button Style="{StaticResource Action}" Content="Open log folder" Click="OnOpenLogs" Padding="12,5" Margin="8,0,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter Margin="0,2" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{Binding Color}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
